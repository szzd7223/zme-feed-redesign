        .nx-feedfoot { min-height: 72px; display: flex; flex-direction: column;
          align-items: center; justify-content: center; padding: 8px 0 4px; }
        .nx-loadmore { display: inline-flex; align-items: center; gap: 8px;
          font-family: var(--font-ibm-plex-mono), monospace; font-size: 11px;
          letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700;
          color: var(--nx-accent); background: transparent;
          border: 1px solid rgba(18,18,204,.4); border-radius: 9px;
          padding: 11px 22px; cursor: pointer; transition: background .15s; }
        .nx-loadmore:hover:not(:disabled) { background: rgba(18,18,204,.06); }
        .nx-loadmore:disabled { color: var(--nx-faint); border-color: rgba(154,149,144,.35);
          cursor: default; }
        .nx-feedspin { width: 11px; height: 11px; border-radius: 50%;
          border: 1.5px solid rgba(154,149,144,.35); border-top-color: var(--nx-faint);
          animation: nx-feedspin 0.7s linear infinite; }
        @keyframes nx-feedspin { to { transform: rotate(360deg); } }
        .nx-feedend { text-align: center; padding: 18px 0 6px; }
        .nx-feedend-rule { width: 34px; height: 2px; background: var(--nx-ink);
          opacity: .8; margin: 0 auto 12px; }
        .nx-feedend-line { font-family: var(--nx-serif, var(--font-fraunces), Georgia, serif);
          font-size: 17px; font-weight: 500; color: var(--nx-ink); margin-bottom: 4px; }
        .nx-feedend-sub { font-family: var(--font-ibm-plex-mono), monospace;
          font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
          color: var(--nx-faint); }
        /* The curious spark turns — always visible, the way a like is always a
           thumb (RK 2026-07-19, "a new symbol of the internet"). Slow + calm. */
        .nx-curspin { animation: nx-curspin 9s linear infinite; }
        @keyframes nx-curspin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) {
          .nx-feedspin { animation: none; }
          .nx-curspin { animation: none; }
        }
