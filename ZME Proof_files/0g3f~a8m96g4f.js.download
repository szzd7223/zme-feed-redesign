        .dcall{position:relative;background:var(--nx-card);border:1.5px solid var(--nx-gold);border-radius:16px;padding:18px 20px;margin:0 0 14px;box-shadow:0 1px 0 rgba(184,134,11,.15)}
        .dcall .dx{position:absolute;top:9px;right:11px;width:26px;height:26px;border:none;background:transparent;color:var(--nx-gold);font-size:20px;line-height:1;cursor:pointer;border-radius:50%;opacity:.65}
        .dcall .dx:hover{opacity:1;background:rgba(184,134,11,.1)}
        .dcall .past{display:inline-block;margin-top:12px;font-family:var(--font-ibm-plex-mono),monospace;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:var(--nx-faint);text-decoration:none}
        .dcall .past:hover{color:var(--nx-gold)}
        .dcall .pin{display:flex;align-items:center;justify-content:space-between;gap:10px}
        .dcall .pin .k{font-family:var(--font-ibm-plex-mono),monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--nx-gold);font-weight:700}
        .dcall .pin .n{font-family:var(--font-ibm-plex-mono),monospace;font-size:10px;color:var(--nx-faint);white-space:nowrap}
        .dcall .q{font-family:var(--font-fraunces),Georgia,serif;font-size:20px;font-weight:600;line-height:1.24;margin:10px 0 15px;color:var(--nx-ink)}
        .dcall .opts{display:flex;flex-direction:column;gap:8px}
        .dcall .opt{position:relative;border:1px solid var(--nx-hair);border-radius:11px;padding:12px 13px;overflow:hidden;background:var(--nx-card);text-align:left;width:100%}
        .dcall button.opt.tap{cursor:pointer}.dcall button.opt.tap:hover{border-color:var(--nx-accent)}
        .dcall .opt .fill{position:absolute;left:0;top:0;bottom:0;background:rgba(18,18,204,.07);z-index:0}
        .dcall .opt.mine{border-color:var(--nx-accent)}.dcall .opt.mine .fill{background:rgba(18,18,204,.13)}
        .dcall .opt .row{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;gap:10px}
        .dcall .opt .t{font-family:var(--font-fraunces),Georgia,serif;font-size:14.5px;color:var(--nx-ink)}
        .dcall .opt .pct{font-family:var(--font-ibm-plex-mono),monospace;font-size:12px;font-weight:600;color:var(--nx-muted)}
        .dcall .opt.mine .pct{color:var(--nx-accent)}
        .dcall .opt .arw{font-family:var(--font-fraunces),serif;font-size:18px;color:var(--nx-faint)}
        .dcall .you{font-family:var(--font-ibm-plex-mono),monospace;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--nx-accent);font-weight:700;margin-left:7px}
        .dcall .foot{font-family:var(--font-ibm-plex-mono),monospace;font-size:10px;line-height:1.5;color:var(--nx-faint);margin-top:13px;letter-spacing:.02em}
        .dcall .share{margin-top:14px;padding-top:13px;border-top:1px solid var(--nx-hair);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
        .dcall .share .st{font-family:var(--font-fraunces),Georgia,serif;font-size:13px;color:var(--nx-muted);line-height:1.35;flex:1;min-width:180px}
        .dcall .share .st b{color:var(--nx-ink);font-weight:600}
        .dcall .share .sb{font-family:var(--font-ibm-plex-mono),monospace;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:var(--nx-ink);color:var(--nx-card);border:none;border-radius:10px;padding:11px 15px;cursor:pointer;white-space:nowrap}
